{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jihocv.vercel.app"
        }
      ],
      "destination": "/jiho-yoon"
    }
  ]
}
